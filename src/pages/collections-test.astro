---
// Throwaway page to verify content collections load correctly. Delete once real pages exist.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const slides = await getCollection('slides');
const notes = await getCollection('notes');
const notebooks = await getCollection('notebooks');
const schedule = await getCollection('schedule');
const forms = await getCollection('forms');
---
<Layout title="Collections test">
  <h1>Content collections smoke test</h1>
  <ul>
    <li>slides: {slides.length} entr{slides.length === 1 ? 'y' : 'ies'} — {slides.map((s) => s.data.title).join(', ')}</li>
    <li>notes: {notes.length} entr{notes.length === 1 ? 'y' : 'ies'} — {notes.map((n) => n.data.title).join(', ')}</li>
    <li>notebooks: {notebooks.length} entr{notebooks.length === 1 ? 'y' : 'ies'} — {notebooks.map((n) => n.data.title).join(', ')}</li>
    <li>schedule: {schedule.length} entr{schedule.length === 1 ? 'y' : 'ies'} — {schedule.map((e) => e.data.eventName).join(', ')}</li>
    <li>forms: {forms.length} entr{forms.length === 1 ? 'y' : 'ies'} — {forms.map((f) => f.data.title).join(', ')}</li>
  </ul>
</Layout>
