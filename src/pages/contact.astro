---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/brand/QSA_Logo_with_text.png';
import {
  AU_INVOLVE_URL,
  GROUPME_URL,
  LINKEDIN_URL,
  INSTAGRAM_URL,
  INSTAGRAM_HANDLE,
} from '../data/contact-links';

const officers = await getCollection('officers');
const byRole = (role: string) => officers.find((o) => o.data.role === role)?.data;

const corners = [
  byRole('president'),
  byRole('vp-operations'),
  byRole('vp-outreach'),
  byRole('vp-programs'),
];

const roleLabels: Record<string, string> = {
  president: 'President',
  'vp-operations': 'VP of Operations',
  'vp-outreach': 'VP of Outreach',
  'vp-programs': 'VP of Programs',
};

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase();
}

const socials = [
  { label: 'LinkedIn', href: LINKEDIN_URL, text: LINKEDIN_URL },
  { label: 'Instagram', href: INSTAGRAM_URL, text: INSTAGRAM_HANDLE },
  { label: 'GroupMe', href: GROUPME_URL, text: GROUPME_URL },
  { label: 'AU Involve', href: AU_INVOLVE_URL, text: AU_INVOLVE_URL },
];

const qrSvg = await QRCode.toString(GROUPME_URL, {
  type: 'svg',
  margin: 1,
  color: { dark: '#1f1d3d', light: '#00000000' },
});
---
<Layout title="Contact — Quantum Society at Auburn">
  <div class="contact-grid">
    <div class="column team-column">
      <h1>The Team</h1>
      <div class="officers">
        {corners.map((officer) => (
          <div class="officer">
            {officer && (
              <>
                <div class="headshot">
                  {officer.photo ? (
                    <Image src={officer.photo} alt={officer.name} width={128} height={128} />
                  ) : (
                    <div class="avatar-fallback">{initials(officer.name)}</div>
                  )}
                </div>
                <p class="name">{officer.name}</p>
                <p class="role">{roleLabels[officer.role]}</p>
                <a class="email" href={`mailto:${officer.email}`}>{officer.email}</a>
              </>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="column">
      <h1>Contact</h1>
      <Image src={logo} alt="Quantum Society at Auburn" width={220} class="logo" />

      <div class="socials">
        {socials.map((social) => (
          <div class="social">
            <p class="social-label">{social.label}</p>
            <a href={social.href}>{social.text}</a>
          </div>
        ))}
      </div>

      <div class="qr-section">
        <p class="social-label">Scan to join GroupMe</p>
        <div class="qr" set:html={qrSvg} />
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-grid {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  .column {
    flex: 1 1 320px;
    max-width: 420px;
    min-width: 0;
  }

  .team-column {
    text-align: center;
  }

  .officers {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
  }

  .socials {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid var(--color-border);
  }

  .officer {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .social {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    margin: -1px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .headshot {
    margin-bottom: var(--space-sm);
  }

  .headshot img {
    display: block;
    width: 150px;
    height: 150px;
    margin: 0 auto;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 150px;
    margin: 0 auto;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.65rem;
  }

  .officer .name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
  }

  .officer .role {
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .officer .email {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .logo {
    display: block;
    margin-bottom: var(--space-lg);
  }

  .social-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    margin-bottom: var(--space-xs);
  }

  .qr-section {
    margin-top: var(--space-lg);
  }

  .qr {
    width: 140px;
    margin-top: var(--space-sm);
  }

  .qr :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
