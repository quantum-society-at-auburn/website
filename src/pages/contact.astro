---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/brand/QSA_Logo_with_text.png';
import auLogo from '../assets/brand/AU_logo.svg';
import {
  AU_INVOLVE_URL,
  GROUPME_URL,
  LINKEDIN_URL,
  INSTAGRAM_URL,
  INSTAGRAM_HANDLE,
} from '../data/contact-links';

const officers = await getCollection('officers');
const byRole = (role: string) => officers.find((o) => o.data.role === role)?.data;

const corners = [
  byRole('president'),
  byRole('vp-operations'),
  byRole('vp-outreach'),
  byRole('vp-programs'),
];

const roleLabels: Record<string, string> = {
  president: 'President',
  'vp-operations': 'VP of Operations',
  'vp-outreach': 'VP of Outreach',
  'vp-programs': 'VP of Programs',
};

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase();
}

const linkedinIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><line x1="7.5" y1="10.5" x2="7.5" y2="17"/><circle cx="7.5" cy="6.7" r="0.9" fill="currentColor" stroke="none"/><path d="M11.5 17v-4a2.3 2.3 0 0 1 4.6 0v4"/><line x1="11.5" y1="10.5" x2="11.5" y2="17"/></svg>`;

const instagramIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="0.8" fill="currentColor" stroke="none"/></svg>`;

const groupmeIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16v10.5H9.5L5 20v-4.5H4z"/><circle cx="8.5" cy="10.5" r="0.8" fill="currentColor" stroke="none"/><circle cx="12" cy="10.5" r="0.8" fill="currentColor" stroke="none"/><circle cx="15.5" cy="10.5" r="0.8" fill="currentColor" stroke="none"/></svg>`;

const socials = [
  { label: 'LinkedIn', href: LINKEDIN_URL, text: null, icon: linkedinIcon },
  { label: 'Instagram', href: INSTAGRAM_URL, text: INSTAGRAM_HANDLE, icon: instagramIcon },
  { label: 'GroupMe', href: GROUPME_URL, text: null, icon: groupmeIcon },
  { label: 'AU Involve', href: AU_INVOLVE_URL, text: null, icon: null },
];

const qrSvg = await QRCode.toString(GROUPME_URL, {
  type: 'svg',
  margin: 1,
  color: { dark: '#1f1d3d', light: '#00000000' },
});
---
<Layout title="Contact — Quantum Society at Auburn">
  <div class="contact-grid">
    <div class="column team-column">
      <h1>The Team</h1>
      <div class="officers">
        {corners.map((officer) => (
          <div class="officer">
            {officer && (
              <>
                <div class="headshot">
                  {officer.photo ? (
                    <Image src={officer.photo} alt={officer.name} width={220} height={220} />
                  ) : (
                    <div class="avatar-fallback">{initials(officer.name)}</div>
                  )}
                </div>
                <p class="name">{officer.name}</p>
                <p class="role">{roleLabels[officer.role]}</p>
                <a class="email" href={`mailto:${officer.email}`}>{officer.email}</a>
              </>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="column contact-column">
      <h1>Contact</h1>
      <Image src={logo} alt="Quantum Society at Auburn" width={220} class="logo" />

      <div class="socials">
        {socials.map((social) => (
          <a class="social" href={social.href}>
            <span class="social-icon">
              {social.icon ? (
                <span class="icon-svg" set:html={social.icon} />
              ) : (
                <Image src={auLogo} alt="Auburn University" width={22} height={19} />
              )}
            </span>
            <span class="social-text">
              <span class="social-label">{social.label}</span>
              {social.text && <span class="social-link-text">{social.text}</span>}
            </span>
          </a>
        ))}
      </div>

      <div class="qr-section">
        <p class="social-label">Scan to join GroupMe</p>
        <div class="qr" set:html={qrSvg} />
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .column {
    max-width: 420px;
    min-width: 0;
  }

  .team-column {
    max-width: 560px;
  }

  .team-column h1 {
    text-align: center;
  }

  .contact-column {
    text-align: center;
  }

  .officers {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-lg);
  }

  .socials {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-lg);
  }

  .officer {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .social-icon {
    display: flex;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--color-muted);
  }

  .social-icon :global(svg),
  .social-icon :global(img) {
    width: 100%;
    height: auto;
  }

  .social-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    min-width: 0;
  }

  .social-text .social-label {
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  .social-text .social-link-text {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .headshot {
    margin-bottom: var(--space-sm);
  }

  .headshot img {
    display: block;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 2.25rem;
  }

  .officer .name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
  }

  .officer .role {
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .officer .email {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .logo {
    display: block;
    margin: 0 auto var(--space-lg);
  }

  .social-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    margin-bottom: var(--space-xs);
  }

  .qr-section {
    margin-top: var(--space-lg);
  }

  .qr {
    width: 140px;
    margin: var(--space-sm) auto 0;
  }

  .qr :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
