---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/brand/QSA_Logo_with_text.png';
import { AU_INVOLVE_URL, GROUPME_URL } from '../data/contact-links';

const officers = await getCollection('officers');
const byRole = (role: string) => officers.find((o) => o.data.role === role)?.data;

const corners = [
  byRole('president'),
  byRole('vp-operations'),
  byRole('vp-outreach'),
  byRole('vp-programs'),
];

const roleLabels: Record<string, string> = {
  president: 'President',
  'vp-operations': 'VP of Operations',
  'vp-outreach': 'VP of Outreach',
  'vp-programs': 'VP of Programs',
};

const qrSvg = await QRCode.toString(GROUPME_URL, {
  type: 'svg',
  margin: 1,
  color: { dark: '#1f1d3d', light: '#00000000' },
});
---
<Layout title="Contact — Quantum Society at Auburn">
  <h1>Contact</h1>
  <p>Reach an officer directly, or find us on AU Involve and GroupMe.</p>

  <div class="contact-grid">
    <div class="officers">
      {corners.map((officer) => (
        <div class="officer">
          {officer && (
            <>
              <p class="role">{roleLabels[officer.role]}</p>
              <p class="name">{officer.name}</p>
              <a href={`mailto:${officer.email}`}>{officer.email}</a>
            </>
          )}
        </div>
      ))}
    </div>

    <div class="links">
      <Image src={logo} alt="Quantum Society at Auburn" width={140} />

      <div class="link-section">
        <h2>AU Involve</h2>
        <a href={AU_INVOLVE_URL}>{AU_INVOLVE_URL}</a>
      </div>

      <div class="link-section">
        <h2>GroupMe</h2>
        <a href={GROUPME_URL}>{GROUPME_URL}</a>
        <div class="qr" set:html={qrSvg} />
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-grid {
    display: flex;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  .officers {
    flex: 1 1 320px;
    max-width: 420px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
  }

  .officer {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    margin: -1px;
  }

  .officer .role {
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .officer .name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    margin-bottom: var(--space-xs);
  }

  .links {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .link-section h2 {
    font-size: 1.125rem;
    margin-bottom: var(--space-xs);
  }

  .qr {
    width: 140px;
    margin-top: var(--space-sm);
  }

  .qr :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
