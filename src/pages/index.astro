---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import quantumComputer from '../assets/brand/Qcomputer.png';
import logoWithText from '../assets/brand/QSA_Logo_with_text.png';
import { AU_INVOLVE_URL, INSTAGRAM_URL, LINKEDIN_URL } from '../data/contact-links';

const base = import.meta.env.BASE_URL;

const schedule = await getCollection('schedule');

const upcoming = schedule
  .filter((event) => event.data.date instanceof Date && event.data.date.valueOf() >= Date.now())
  .sort((a, b) => (a.data.date as Date).valueOf() - (b.data.date as Date).valueOf())
  .slice(0, 3);

const alwaysShow = schedule.filter((event) => typeof event.data.date === 'string');

const events = [...upcoming, ...alwaysShow].reverse();

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

function formatDate(date: Date | string) {
  return date instanceof Date ? dateFormatter.format(date) : date;
}

const logo = await getImage({ src: logoWithText, width: 600, format: 'png' });
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Quantum Society at Auburn',
  alternateName: ['QSA', 'Auburn Quantum Club', 'Quantum Club at Auburn'],
  url: new URL(base, Astro.site).href,
  logo: new URL(logo.src, Astro.site).href,
  description: "Auburn University's quantum computing club.",
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Auburn University' },
  sameAs: [LINKEDIN_URL, INSTAGRAM_URL, AU_INVOLVE_URL],
};
---
<Layout title="Quantum Society at Auburn | Quantum Computing Club at Auburn University" fullTitle>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organization)} />
  <section class="hero">
    <aside class="announcements-panel">
      <a class="panel-title" href={`${base}announcements`}>Announcements</a>
      <ul class="mini-schedule">
        <li class="mini-row pinned">
          <span class="mini-date">Biweekly</span>
          <div class="mini-details">
            <h3>Meetings</h3>
            <p class="mini-meta">Wednesdays, 5:00 PM &middot; Govil Hall, Room 2126</p>
          </div>
        </li>
        {events.map((event) => (
          <li class="mini-row">
            <span class="mini-date">{formatDate(event.data.date)}</span>
            <div class="mini-details">
              <h3>
                {event.data.rsvpFormSlug ? (
                  <a href={`${base}forms/${event.data.rsvpFormSlug}`}>{event.data.eventName}</a>
                ) : (
                  event.data.eventName
                )}
              </h3>
              <p class="mini-meta">{event.data.time} &middot; {event.data.location}</p>
            </div>
          </li>
        ))}
      </ul>
    </aside>

    <div class="hero-text">
      <p class="eyebrow">Welcome!</p>
      <h1>Quantum Society at Auburn</h1>
      <p>
        The Quantum Society at Auburn (QSA) is Auburn University's quantum computing club, a community for anyone curious about quantum science.
        Founded this semester, our goal is to build a community and interest in learning about applications of quantum physics, from
        computing to sensing. Our meetings are biweekly, Wednesdays at 5PM in the brand new Govil Hall (Stem+Ag Building A), where we
        host workshops teaching people about the fundamentals of quantum computing. We also host a competitive hackathon team, where we'll
        have practices and compete in virtual and in-person quantum hackathons.
      </p>
      <p class="links">
        <a class="button" href={`${base}resources`}>Browse resources</a>
        <a href={`${base}announcements`}>See upcoming meetings</a>
        <a href={`${base}contact`}>Get in touch</a>
      </p>
    </div>
    <div class="hero-visual">
      <Image src={quantumComputer} alt="Illustration of a dilution refrigerator housing a quantum computer" width={280} loading="eager" />
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
  }

  .hero-text {
    flex: 1 1 300px;
    max-width: 560px;
    align-self: center;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-muted);
    font-weight: 600;
  }

  .announcements-panel {
    flex: 0 0 260px;
    border-right: 1px solid var(--color-border);
    padding-right: var(--space-lg);
  }

  .panel-title {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: var(--space-md);
  }

  .panel-title:hover {
    color: var(--color-link-hover);
  }

  .mini-schedule {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mini-row {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border);
  }

  .mini-row:first-child {
    border-top: none;
  }

  .mini-row.pinned {
    border-top: none;
    border-left: 3px solid var(--color-accent);
    padding: var(--space-xs) 0 var(--space-sm) var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .mini-date {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .mini-details h3 {
    font-size: 0.9375rem;
    margin-bottom: var(--space-xs);
  }

  .mini-meta {
    color: var(--color-muted);
    font-size: 0.8125rem;
    margin-bottom: 0;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    max-width: 16ch;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero-visual {
    flex: 1 1 280px;
    display: flex;
    justify-content: center;
    align-self: center;
  }

  .hero img {
    width: 280px;
    height: auto;
  }
</style>
