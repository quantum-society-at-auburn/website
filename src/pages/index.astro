---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import quantumComputer from '../assets/brand/Qcomputer.png';

const base = import.meta.env.BASE_URL;
---
<Layout title="Quantum Society at Auburn">
  <section class="hero">
    <div class="hero-text">
      <h1>Quantum computing, studied together.</h1>
      <p>
        The Quantum Society at Auburn is a student group for anyone curious about
        quantum computing and quantum physics — no prior background required.
        We run weekly sessions, share what we're reading, and build things with
        real quantum hardware and simulators.
      </p>
      <p class="links">
        <a class="button" href={`${base}resources`}>Browse resources</a>
        <a href={`${base}announcements`}>See upcoming meetings</a>
        <a href={`${base}contact`}>Get in touch</a>
      </p>
    </div>
    <Image src={quantumComputer} alt="Illustration of a dilution refrigerator used in quantum computing" width={280} loading="eager" />
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .hero-text {
    flex: 1 1 420px;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    max-width: 16ch;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero img {
    flex: 0 1 280px;
    height: auto;
  }
</style>
