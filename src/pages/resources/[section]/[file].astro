---
import Layout from '../../../layouts/Layout.astro';
import { getResourceSections } from '../../../lib/resources';
import type { ResourceFile } from '../../../lib/resources';

export async function getStaticPaths() {
  const sections = getResourceSections();
  return sections.flatMap((section) =>
    section.files.map((file) => ({
      params: { section: section.sectionSlug, file: file.slug },
      props: { file, sectionTitle: section.section },
    }))
  );
}

interface Props {
  file: ResourceFile;
  sectionTitle: string;
}

const { file, sectionTitle } = Astro.props;
const base = import.meta.env.BASE_URL;

const IMAGE_EXTS = ['.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg'];
const OFFICE_EXTS = ['.ppt', '.pptx', '.doc', '.docx', '.xls', '.xlsx'];

const isPdf = file.ext === '.pdf';
const isImage = IMAGE_EXTS.includes(file.ext);
const isOffice = OFFICE_EXTS.includes(file.ext);

const absoluteUrl = new URL(file.url, Astro.site);
const officeViewerUrl = `https://view.officeapps.live.com/op/view.aspx?src=${encodeURIComponent(absoluteUrl.href)}`;
---
<Layout title={`${file.title} — Quantum Society at Auburn`}>
  <p class="breadcrumb"><a href={`${base}resources`}>Resources</a> / {sectionTitle}</p>
  <h1>{file.title}</h1>

  {isPdf && (
    <iframe src={file.url} width="100%" height="900" loading="lazy">Loading…</iframe>
  )}

  {isImage && <img src={file.url} alt={file.title} />}

  {isOffice && (
    import.meta.env.PROD ? (
      <iframe src={officeViewerUrl} width="100%" height="900" loading="lazy">Loading…</iframe>
    ) : (
      <p>Preview available once this page is live — download to view now.</p>
    )
  )}

  {!isPdf && !isImage && !isOffice && (
    <p>Preview not available for this file type — download it to view.</p>
  )}

  <p><a class="button" href={file.url} download={file.filename}>Download</a></p>
</Layout>

<style>
  .breadcrumb {
    color: var(--color-muted);
    margin-bottom: var(--space-md);
  }

  iframe {
    display: block;
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }
</style>
