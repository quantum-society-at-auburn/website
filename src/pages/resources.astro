---
import Layout from '../layouts/Layout.astro';
import { getResourceSections } from '../lib/resources';

const base = import.meta.env.BASE_URL;
const sections = getResourceSections();
---
<Layout title="Resources — Quantum Society at Auburn">
  <h1>Resources</h1>
  <p>Slides, notes, and other materials from past sessions, organized by week.</p>

  {sections.length === 0 && <p>No resources posted yet — check back soon.</p>}

  {sections.map((section) => (
    <section class="resource-section">
      <h2>{section.section}</h2>
      <ul class="file-list">
        {section.files.map((file) => (
          <li class="row">
            <a href={`${base}resources/${section.sectionSlug}/${file.slug}`}>{file.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<style>
  .resource-section {
    margin-top: var(--space-xl);
  }

  .resource-section h2 {
    margin-bottom: var(--space-sm);
  }

  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .row a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.0625rem;
  }
</style>
