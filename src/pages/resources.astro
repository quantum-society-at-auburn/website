---
import Layout from '../layouts/Layout.astro';
import { getAdditionalResources, getResourceSections, groupFilesByCategory } from '../lib/resources';

const base = import.meta.env.BASE_URL;
const sections = getResourceSections();
const additionalResources = getAdditionalResources();

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Layout
  title="Resources"
  description="Slides, notes, and Qiskit notebooks from Quantum Society at Auburn workshops on quantum computing."
>
  <h1>Resources</h1>
  <p>Slides, notes, and other materials from past sessions</p>

  {sections.length === 0 && <p>Nothing yet, check again soon</p>}

  <div class="resource-grid">
    {sections.map((section) => {
      const groups = groupFilesByCategory(section.files);
      return (
        <details class="resource-card">
          <summary>
            <h2>{section.title}</h2>
            {section.date && <p class="card-date">{dateFormatter.format(section.date)}</p>}
            {section.description && <p class="card-description">{section.description}</p>}
          </summary>
          <div class="card-content">
            {groups.map((group) => (
              <div class="category-group">
                <h3>{group.label}</h3>
                <ul class="file-list">
                  {group.files.map((file) => (
                    <li class="row">
                      <a href={`${base}resources/${section.sectionSlug}/${file.slug}`}>{file.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {section.links.length > 0 && (
              <div class="category-group">
                <h3>Links</h3>
                <ul class="file-list">
                  {section.links.map((link) => (
                    <li class="row">
                      <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>
                      {link.description && <p class="link-desc">{link.description}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {groups.length === 0 && section.links.length === 0 && (
              <p class="empty-note">Nothing here yet.</p>
            )}
          </div>
        </details>
      );
    })}
  </div>

  {additionalResources.length > 0 && (
    <section class="additional-resources">
      <h2>Additional Resources</h2>
      <p class="additional-intro">Other places to learn quantum computing</p>
      <ul class="file-list additional-list">
        {additionalResources.map((link) => (
          <li class="row">
            <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>
            {link.description && <p class="link-desc">{link.description}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<style>
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    align-items: start;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
  }

  .resource-card {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-md);
  }

  .resource-card:not([open]) {
    height: 168px;
  }

  .resource-card summary {
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: var(--space-lg);
  }

  .resource-card summary::-webkit-details-marker {
    display: none;
  }

  .resource-card summary::after {
    content: '+';
    position: absolute;
    top: 0;
    right: 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-muted);
  }

  .resource-card[open] summary::after {
    content: '\2212';
  }

  .resource-card summary:hover h2 {
    color: var(--color-link-hover);
  }

  .resource-card h2 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 1.1875rem;
    margin-bottom: 0;
  }

  .card-date {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .card-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  .card-content {
    margin-top: var(--space-md);
    overflow: hidden;
    transition: max-height 0.25s ease, opacity 0.2s ease;
  }

  .empty-note {
    color: var(--color-muted);
    margin-top: var(--space-md);
    margin-bottom: 0;
  }

  .category-group {
    margin-top: var(--space-lg);
  }

  .category-group:first-child {
    margin-top: var(--space-md);
  }

  .category-group h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .row a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .link-desc {
    margin: var(--space-xs) 0 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .additional-resources {
    margin-top: calc(var(--space-xl) * 2);
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
  }

  .additional-intro {
    color: var(--color-muted);
  }

  .additional-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    column-gap: var(--space-xl);
  }

  /* In the multi-column list every row gets a bottom rule so columns end evenly. */
  .additional-list .row {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: -1px;
  }
</style>

<script>
  function initResourceCard(details: HTMLDetailsElement) {
    const summary = details.querySelector('summary');
    const content = details.querySelector<HTMLElement>('.card-content');
    if (!summary || !content) return;

    let animating = false;

    function openCard() {
      details.open = true;
      content!.style.maxHeight = '0px';
      content!.style.opacity = '0';
      // Force layout so the browser registers the collapsed state before
      // animating to the target height, otherwise the transition is skipped.
      content!.offsetHeight;
      const targetHeight = content!.scrollHeight;
      content!.style.maxHeight = `${targetHeight}px`;
      content!.style.opacity = '1';
      animating = true;
      content!.addEventListener('transitionend', function onEnd(event) {
        if (event.propertyName !== 'max-height') return;
        content!.removeEventListener('transitionend', onEnd);
        // Let the panel size naturally afterward (e.g. on viewport resize).
        content!.style.maxHeight = 'none';
        animating = false;
      });
    }

    function closeCard() {
      const startHeight = content!.scrollHeight;
      content!.style.maxHeight = `${startHeight}px`;
      content!.offsetHeight;
      content!.style.maxHeight = '0px';
      content!.style.opacity = '0';
      animating = true;
      content!.addEventListener('transitionend', function onEnd(event) {
        if (event.propertyName !== 'max-height') return;
        content!.removeEventListener('transitionend', onEnd);
        details.open = false;
        animating = false;
      });
    }

    function toggle(event: Event) {
      event.preventDefault();
      if (animating) return;
      if (details.open) {
        closeCard();
      } else {
        openCard();
      }
    }

    summary.addEventListener('click', toggle);
    // Belt-and-suspenders: explicitly handle Enter/Space too, rather than
    // relying on the browser synthesizing a 'click' from key activation.
    // The `animating` guard above makes this safe even if both fire.
    summary.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
        toggle(event);
      }
    });
  }

  document.querySelectorAll<HTMLDetailsElement>('.resource-card').forEach(initResourceCard);
</script>
