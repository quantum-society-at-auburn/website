---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'forms'>;
}

const { entry } = Astro.props;
const { formType, formId, googleFormUrl } = entry.data;
---

{formType === 'formspree' && formId && (
  <form action={`https://formspree.io/f/${formId}`} method="POST">
    <label>
      Name
      <input type="text" name="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" required />
    </label>
    <label>
      Message
      <textarea name="message"></textarea>
    </label>
    <button type="submit">Submit</button>
  </form>
)}

{formType === 'google' && googleFormUrl && (
  <iframe src={googleFormUrl} width="100%" height="900" frameborder="0" marginheight="0" marginwidth="0">
    Loading…
  </iframe>
)}
