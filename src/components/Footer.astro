---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <p>Quantum Society at Auburn &middot; <a href={`${base}contact`}>Get in touch</a></p>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: #fff;
    padding: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .footer p {
    margin: 0 0 var(--space-xs);
    max-width: none;
  }

  .footer a {
    color: var(--color-accent);
  }

  .footer a:hover {
    color: #fff;
  }
</style>
